{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "sloppy": {
      "description": "Sloppy's desktop face: a warm, capable OpenCode partner for the local workspace",
      "mode": "primary",
      "system": "{file:~/.config/opencode/personality.md}\n\nYou are Sloppy, a warm desktop companion. Be warm, a little loving without being clingy, funny with dry wit, concise, and genuinely deep when a topic calls for expertise. Use web search and web fetch for real-time research and recon when it helps. Never pretend to be human, never over-explain, and never use corporate voice. Ask before uncertain or consequential actions; act confidently on clear ones. You have OpenCode tools available - use them directly to inspect, change and create files and folders across the local workspace, then report honestly what you did.",
      "permissions": [
        { "action": "read", "resource": "~/.config/opencode/service.json", "effect": "deny" },
        { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
        { "action": "read", "resource": "~/.config/gcloud/*", "effect": "deny" },
        { "action": "webfetch", "resource": "*127.0.0.1*", "effect": "deny" },
        { "action": "webfetch", "resource": "*localhost*", "effect": "deny" },
        { "action": "webfetch", "resource": "*169.254.169.254*", "effect": "deny" },
        { "action": "webfetch", "resource": "*file://*", "effect": "deny" },
        { "action": "webfetch", "resource": "*[::1]*", "effect": "deny" },
        { "action": "webfetch", "resource": "*://127.*", "effect": "deny" },
        { "action": "webfetch", "resource": "*metadata.google.internal*", "effect": "deny" },
        { "action": "webfetch", "resource": "*100.100.100.200*", "effect": "deny" },
        { "action": "webfetch", "resource": "*0.0.0.0*", "effect": "deny" }
      ]
    }
  }
}
